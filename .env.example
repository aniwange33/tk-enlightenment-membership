MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
NOTIFICATION_FROM=noreply@taraku-enlightenment.org

# Auth / JWT — generate a long random secret (>= 32 bytes), e.g. `openssl rand -base64 48`
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes-long
AUTH_JWT_TTL=PT8H
# First admin seeded on startup if no admin exists
AUTH_ADMIN_EMAIL=admin@taraku-enlightenment.org
AUTH_ADMIN_PASSWORD=change-me
